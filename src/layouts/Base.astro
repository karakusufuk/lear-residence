---
import '@fontsource/gloock/400.css';
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '@fontsource/instrument-sans/700.css';
import gloockLatin from '@fontsource/gloock/files/gloock-latin-400-normal.woff2?url';
import sansLatin from '@fontsource/instrument-sans/files/instrument-sans-latin-500-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConceptModal from '../components/ConceptModal.astro';

const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.webp', { eager: true });

interface Props {
  title: string;
  description: string;
  current?: string;
  home?: boolean;
  noFooter?: boolean;
  ogPhoto?: string;
  noindex?: boolean;
}
const { title, description, current = '', home = false, noFooter = false, ogPhoto = 'HERO-DAY', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = await getImage({ src: photos[`/src/assets/photos/${ogPhoto}.webp`].default, width: 1200, height: 630, fit: 'cover', format: 'jpeg' });
const ogUrl = new URL(og.src, Astro.site).href;
---
<!doctype html>
<html lang="en-IE">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#0E2A20" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preload" href={gloockLatin} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={sansLatin} as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Lear" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div id="top" class="pg">
    <Header current={current} home={home} />
    <main id="main">
      <slot />
    </main>
    {!noFooter && <Footer />}
  </div>
  <script>
    import '../scripts/main.ts';
  </script>
  <ConceptModal />
</body>
</html>
