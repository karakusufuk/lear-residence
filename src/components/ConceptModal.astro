---
import { CASE_STUDY_URL } from '../config/site';
---
<div class="cm" data-concept-modal hidden>
  <div class="cm-card" role="dialog" aria-modal="true" aria-labelledby="cm-h" aria-describedby="cm-b">
    <p class="cm-lbl">Concept site</p>
    <h2 id="cm-h" class="serif">Concept site by Ufuk Karakuş</h2>
    <p id="cm-b" class="cm-body" data-concept-body></p>
    <div class="cm-actions">
      <a class="btn light" href={CASE_STUDY_URL} target="_blank" rel="noopener">See how it works →</a>
      <button type="button" class="cm-close" data-concept-close>Close</button>
    </div>
  </div>
</div>
<style is:global>
  .cm { position: fixed; inset: 0; z-index: 200; display: flex; align-items: center; justify-content: center; padding: 20px; background: rgba(14, 42, 32, .55); opacity: 0; transition: opacity .3s var(--ease); }
  .cm[hidden] { display: none; }
  .cm.is-open { opacity: 1; }
  .cm-card { width: min(520px, 100%); background: var(--bottle); color: var(--cream); border-radius: var(--radius); padding: 44px 44px 40px; transform: translateY(16px); transition: transform .5s var(--ease); }
  .cm.is-open .cm-card { transform: none; }
  .cm-lbl { font: 600 13px var(--font-body); letter-spacing: .08em; text-transform: uppercase; color: var(--cream-2); }
  .cm-card h2 { font-size: clamp(30px, 4vw, 40px); line-height: 1.1; margin-top: 14px; }
  .cm-body { margin-top: 18px; color: var(--cream-2); font-size: var(--fs-body); }
  .cm-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 14px 24px; margin-top: 32px; }
  .cm-card .btn:focus-visible, .cm-close:focus-visible { outline: 2px solid var(--moss); outline-offset: 4px; }
  .cm-close { background: transparent; border: 0; padding: 12px 4px; min-height: 44px; font: 600 16px var(--font-body); color: var(--cream); cursor: pointer; text-decoration: underline; text-decoration-color: var(--line-dark); text-underline-offset: 5px; transition: text-decoration-color .35s, color .35s; }
  .cm-close:hover { text-decoration-color: var(--moss); color: var(--moss); }
  @media (max-width: 640px) {
    .cm { align-items: flex-end; padding: 0; }
    .cm-card { width: 100%; border-radius: 12px 12px 0 0; padding: 32px 20px calc(28px + env(safe-area-inset-bottom)); transform: translateY(100%); }
    .cm-actions .btn { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cm, .cm-card { transition: none; transform: none; }
  }
</style>
