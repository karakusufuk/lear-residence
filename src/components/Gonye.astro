---
// The steel set square (L ruler): a heavy edge colour with a thin ground-coloured line on top makes the double line.
interface Props { size?: number; edge?: string; fill?: string; ticks?: boolean }
const { size = 40, edge = '#EFEBE2', fill = '#0E2A20', ticks = true } = Astro.props;
const xs = [11, 15, 19, 23, 27, 31, 35];
const ys = [33, 29, 25, 21, 17, 13, 9];
---
<svg width={size} height={size} viewBox="0 0 44 44" aria-hidden="true" focusable="false">
  <path d="M7 5 V37 H39" fill="none" stroke={edge} stroke-width="9" stroke-linecap="square" stroke-linejoin="miter" />
  <path d="M7 5 V37 H39" fill="none" stroke={fill} stroke-width="5.6" stroke-linecap="square" stroke-linejoin="miter" />
  {ticks && (
    <g fill="none" stroke="#7A9F45" stroke-width="1.2">
      {xs.map((x, i) => <path d={`M${x} 39.4 V${i % 2 === 0 ? 36 : 37.6}`} />)}
      {ys.map((y, i) => <path d={`M4.6 ${y} H${i % 2 === 0 ? 8 : 6.4}`} />)}
    </g>
  )}
</svg>
